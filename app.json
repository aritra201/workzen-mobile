{
  "expo": {
    "name": "WorkZen",
    "slug": "workzen-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workzen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workzen.mobile"
    },
    "android": {
      "package": "com.workzen.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1628"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "@react-native-community/datetimepicker"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
