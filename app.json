{
  "expo": {
    "name": "WorkZen",
    "slug": "workzen-mobile",
    "version": "1.0.58",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workzen",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workzen.mobile",
      "buildNumber": "58"
    },
    "android": {
      "package": "com.workzen.mobile",
      "versionCode": 58,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1628"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "webAppLinkHost": "workzen.in",
      "eas": {
        "projectId": "6bf2d0da-2c1f-4424-9a07-1a10f793b98c"
      }
    },
    "owner": "aritra007bera"
  }
}
